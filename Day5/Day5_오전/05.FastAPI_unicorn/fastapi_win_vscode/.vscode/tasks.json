{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FastAPI: Run lesson",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "scripts/run_lesson.py",
        "${input:lesson}",
        "--port",
        "${input:port}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "FastAPI: Verify all",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "FastAPI: Check environment",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "scripts/check_environment.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "lesson",
      "type": "pickString",
      "description": "Lesson number",
      "options": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ],
      "default": "1"
    },
    {
      "id": "port",
      "type": "promptString",
      "description": "Port",
      "default": "8000"
    }
  ]
}
